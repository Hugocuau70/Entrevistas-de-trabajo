{
  "version": "1.0",
  "name": "Uber para Empresas · Sistema audiovisual",
  "locale": "es-MX",
  "provenance": "Adaptación para entrevista. Paleta base de marca pública y presets audiovisuales propuestos.",
  "color": {
    "light": "#FFFFFF",
    "dark": "#000000",
    "surface": "#F3F3F3",
    "textSecondary": "#545454",
    "decorativeBorder": "#D9D9D9",
    "accent": "#276EF1"
  },
  "type": {
    "display": "Uber Move Display",
    "body": "Uber Move Text",
    "fallback": "Arial, Helvetica, sans-serif",
    "displayWeight": 700,
    "bodyWeight": 400,
    "displayLineHeight": 1.03,
    "bodyLineHeight": 1.3
  },
  "format": {
    "16:9": {"width": 1920, "height": 1080, "columns": 12, "safe": {"left": 96, "right": 96, "top": 64, "bottom": 64}, "typePx": {"title": 92, "support": 44, "captions": 40}},
    "9:16": {"width": 1080, "height": 1920, "columns": 6, "safe": {"left": 80, "right": 160, "top": 200, "bottom": 320}, "typePx": {"title": 80, "support": 44, "captions": 44}},
    "1:1": {"width": 1080, "height": 1080, "columns": 6, "safe": {"left": 72, "right": 72, "top": 72, "bottom": 72}, "typePx": {"title": 72, "support": 38, "captions": 38}}
  },
  "motion": {
    "textInMs": 240,
    "textOutMs": 160,
    "textTravelPx": 16,
    "textStaggerMs": 80,
    "dissolveMs": 200,
    "routeRevealMs": 480,
    "easeOut": "cubic-bezier(.2,.8,.2,1)",
    "suggestedReadMs": 2000,
    "endCardHoldMs": [2000, 3000],
    "reducedMotion": "static"
  }
}
